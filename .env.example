# Groq Cloud API Credentials
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Remote MCP Settings (Only required for /ask/remote mode)
# Must be a public HTTPS endpoint reachable by Groq servers (e.g. ngrok or cloudflare tunnel)
MCP_PUBLIC_URL=https://your-host.example.com/mcp-server/mcp

# Langfuse LLM Observability & Tracing
# Get keys at: https://cloud.langfuse.com or your self-hosted Langfuse instance
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
